{
  "name": "expo-cinema-tv-app",
  "version": "1.0.0",
  "scripts": {
    "start": "EXPO_TV=1 expo start",
    "android": "EXPO_TV=1 expo run:android --device",
    "ios": "EXPO_TV=1 expo run:ios --device",
    "web": "expo start --web",
    "prebuild:tv": "EXPO_TV=1 expo prebuild --clean",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@expo/metro-runtime": "~6.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.14.0",
    "@react-navigation/native": "^7.1.28",
    "@react-navigation/native-stack": "^7.13.0",
    "expo": "^54.0.20",
    "expo-blur": "~15.0.8",
    "expo-localization": "~17.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-video": "~3.0.16",
    "i18next": "^25.8.14",
    "lucide-react-native": "0.335.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-i18next": "^16.5.4",
    "react-native": "npm:react-native-tvos@0.81-stable",
    "react-native-fast-image": "^8.6.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.3",
    "react-native-web": "^0.21.0",
    "react-tv-space-navigation": "^6.0.0-beta1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@emotion/native": "^11.11.0",
    "@react-native-tvos/config-tv": "^0.1.4",
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native"
      ]
    }
  },
  "private": true
